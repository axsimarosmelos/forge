# Apply on the separate Judge0 server and workers, not the Forge API container.
# Merge with the maintained release's required database, Redis, and auth settings.
# Generate real independent AUTHN_TOKEN / database / Redis secrets privately.
ENABLE_NETWORK=false
ALLOW_ENABLE_NETWORK=false
ENABLE_COMPILER_OPTIONS=true
ENABLE_COMMAND_LINE_ARGUMENTS=false
ENABLE_ADDITIONAL_FILES=false
ENABLE_CALLBACKS=false
ENABLE_BATCHED_SUBMISSIONS=false
ENABLE_WAIT_RESULT=false
CPU_TIME_LIMIT=2
CPU_EXTRA_TIME=0.25
WALL_TIME_LIMIT=5
MEMORY_LIMIT=262144
STACK_LIMIT=16384
MAX_PROCESSES_AND_OR_THREADS=4
MAX_FILE_SIZE=64
NUMBER_OF_RUNS=1
MAX_NUMBER_OF_RUNS=1
ENABLE_PER_PROCESS_AND_THREAD_TIME_LIMIT=false
ALLOW_ENABLE_PER_PROCESS_AND_THREAD_TIME_LIMIT=false
ENABLE_PER_PROCESS_AND_THREAD_MEMORY_LIMIT=false
ALLOW_ENABLE_PER_PROCESS_AND_THREAD_MEMORY_LIMIT=false
# Judge0 uses these larger global maxima for compilation isolation as well.
MAX_CPU_TIME_LIMIT=15
MAX_CPU_EXTRA_TIME=2
MAX_WALL_TIME_LIMIT=20
MAX_MEMORY_LIMIT=524288
MAX_STACK_LIMIT=131072
MAX_MAX_PROCESSES_AND_OR_THREADS=64
MAX_MAX_FILE_SIZE=4096
COUNT=2
MAX_QUEUE_SIZE=8
