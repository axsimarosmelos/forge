# Never commit your real .env file. Generate each token independently.
# Generate FORGE_API_TOKEN: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
FORGE_API_TOKEN=replace-with-a-random-64-character-hex-token
FORGE_ALLOWED_ORIGINS=https://axsimarosmelos.github.io
JUDGE0_URL=https://your-private-judge0.example.com
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_AUTH_TOKEN=replace-with-your-provider-secret
# Read your provider's /languages response. Do not assume universal IDs.
JUDGE0_C_LANGUAGE_ID=
JUDGE0_CPP_LANGUAGE_ID=
# Only when using a RapidAPI provider, choose X-RapidAPI-Key above and set:
# JUDGE0_RAPIDAPI_HOST=your-provider-host
